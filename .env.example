# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# OpenAI API key — required for the Discovery Assistant (AI chat)
OPENAI_API_KEY=sk-...

# ServiceNow PDI credentials for sync_from_instance.py
SN_INSTANCE=dev12345.service-now.com
SN_USER=admin
SN_PASSWORD=your-password-here
